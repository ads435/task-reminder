PORT=3000
APP_URL=http://localhost:3000
# Optional: protect the whole app with a password (browser login prompt; any username)
APP_PASSWORD=
# Timezone used for "today" and the send hour
TZ=Asia/Kolkata

# SMTP — leave SMTP_HOST empty for dry-run mode (nothing is emailed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
# Gmail/Workspace: use an App Password, not your normal password
SMTP_PASS=
MAIL_FROM="Renewal Tracker <you@example.com>"
